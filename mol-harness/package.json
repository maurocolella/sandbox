{
  "name": "mol-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Corpus-scale validation of the structure loaders (PDB today; mmCIF and BinaryCIF next) against the harvested PDB archive.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:pdb": "vitest run tests/pdb-bulk.spec.ts",
    "test:cif": "vitest run tests/cif-tokenize.spec.ts tests/cif-document.spec.ts"
  },
  "dependencies": {
    "cif-parser": "workspace:*",
    "pdb-parser": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "vitest": "^1.6.0"
  }
}
